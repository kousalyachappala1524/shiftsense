# Copy to .streamlit/secrets.toml (git-ignored) for local use,
# or paste into Streamlit Community Cloud > your app > Settings > Secrets.
ANTHROPIC_API_KEY = "paste-your-key-here"

# Optional
# CONTACT_EMAIL = "you@example.com"     # where the Multi-site Pro waitlist button sends email
# WAITLIST_URL = "https://forms..."     # or a form link instead of email
# AI_CALLS_PER_SESSION = "15"        # max AI requests per visitor session (protects your API budget)
# CLAUDE_MODEL = "claude-opus-5-5"   # model used by the AI analyst
